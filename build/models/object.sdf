<?xml version="1.0"?>
<sdf version="1.7" xmlns:drake="http://drake.mit.edu">
  <model name="object">
    <link name="object">
      <pose>0.0 0.0 0.21 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>6.400000000000001e-05</ixx><iyy>6.400000000000001e-05</iyy><izz>6.400000000000001e-05</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="object_sphere">
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <drake:proximity_properties>
          <drake:mu_static>1.0</drake:mu_static>
          <drake:mu_dynamic>1.0</drake:mu_dynamic>
        </drake:proximity_properties>
      </collision>
      <visual name="object_visual">
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <material><diffuse>0.2 0.4 0.9 0.6</diffuse></material>
      </visual>
    </link>
    <!-- Unactuated: effort 0 => Drake attaches no actuator to this joint. -->
    <joint name="object_yaw" type="revolute">
      <parent>world</parent>
      <child>object</child>
      <axis><xyz>0 0 1</xyz><limit><effort>0</effort></limit></axis>
    </joint>
  </model>
</sdf>
